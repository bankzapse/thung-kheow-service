# ============================================================
# Recycle Fund — Environment variables
# คัดลอกเป็น .env.local แล้วเติมค่า
# ⚠️ PRODUCTION ต้องตั้งค่า [REQUIRED] ให้ครบ ไม่งั้นแอปจะ fallback เป็น "โหมดเดโม" เงียบ ๆ (อันตราย)
#    ตัวที่ไม่มี [REQUIRED] = ออปชัน
# ============================================================

# ---------- Supabase (Phase 1: backend จริง) — [REQUIRED prod] ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=   # หรือ NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=       # server-only — ห้าม expose ฝั่ง client

# ---------- Google Maps ----------
GOOGLE_MAPS_API_KEY=               # server: Distance Matrix (จัดเส้นทางระยะถนนจริง) — ไม่มี = fallback เส้นตรง

# ---------- LINE Login + LIFF (ผู้ขายล็อกอิน/เปิดแอปในไลน์) ----------
# ⚠️ LINE Login กับ Messaging API เป็นคนละ channel — ต้องอยู่ "provider เดียวกัน"
#    ไม่งั้น userId ที่ได้ตอนล็อกอินจะคนละค่ากับที่ใช้ส่งข้อความผ่าน OA
# LIFF ใช้แค่ 2 ตัวนี้ (ไม่ต้องมี CHANNEL_SECRET/REDIRECT_URI เพราะไม่ได้ใช้ OAuth code flow)
NEXT_PUBLIC_LIFF_ID=           # LIFF app ใน LINE Login channel — ไม่ตั้ง = ปิดฟีเจอร์ LINE ทั้งหมด
LINE_LOGIN_CHANNEL_ID=         # Basic settings ของ Login channel — ใช้ตรวจว่า token มาจาก channel เรา

# ---------- LINE Messaging API / OA ----------
# ยังไม่จำเป็นสำหรับล็อกอิน — ใส่เมื่อจะทำ Rich Menu / แจ้งเตือนผ่าน OA
LINE_CHANNEL_ACCESS_TOKEN=     # push ข้อความ + Rich Menu (ต้องอยู่ provider เดียวกับ LINE Login)
LINE_CHANNEL_SECRET=           # ตรวจ signature webhook (/api/line/webhook)
# Rich Menu: ตั้ง token ข้างบนแล้วรัน  node scripts/line-richmenu.mjs deploy
# Webhook: Messaging API channel → Webhook URL = https://<โดเมน>/api/line/webhook → เปิด Use webhook

# ---------- SMS OK (OTP ยืนยันเบอร์โทร) — [REQUIRED prod] ----------
# ขอ key/secret + ลงทะเบียน Sender ID ที่ https://developer.smsok.co
SMSOK_API_KEY=
SMSOK_API_SECRET=
SMSOK_SENDER=Chao-Dee          # ต้องเป็น Sender ID ชนิด OTP/Transactional (ไม่ใช่ Generic/โฆษณา) ไม่งั้นโดน Anti-Spam
# SMSOK_API_URL=https://api.smsok.co   # ออปชัน
OTP_SECRET=                    # [REQUIRED prod] สุ่มสตริงยาว ๆ เซ็นโทเคน OTP (prod ต้องตั้ง ไม่งั้น verify จะปิดตาย fail-closed)
                               # สร้างด้วย: openssl rand -base64 32
                               # ไม่มี fallback แล้ว — ไม่ตั้ง = verify ปิดตาย (ห้ามยืม SMSOK_API_SECRET: หมุน key แล้วโทเคนตาย + secret ปนหน้าที่กัน)

# ---------- SEO / เว็บ ----------
NEXT_PUBLIC_SITE_URL=              # [REQUIRED prod] โดเมนจริง เช่น https://app.thungkhiao.co
                                   # ใช้ทำ canonical / OG / sitemap / JSON-LD — ตั้งผิด = Google เก็บ URL ผิดโดเมน
                                   # ไม่ตั้ง = ใช้ https://app.thungkhiao.co (ดู src/lib/site.ts)

# ---------- อื่น ๆ ----------
NEXT_PUBLIC_COMPANY_PROMPTPAY=     # [REQUIRED prod] พร้อมเพย์บริษัท (ปลายทางเติมเครดิตพาร์ทเนอร์)
                                   # เบอร์ 10 หลัก หรือเลขบัตร ปชช. 13 หลัก · ไม่ตั้ง/ผิดรูปแบบ = ซ่อน QR เติมเครดิต (fail-closed)
                                   # ⚠️ NEXT_PUBLIC_* ฝังตอน build — แก้ค่าแล้วต้อง Redeploy
# NEXT_PUBLIC_DEMO=off             # "off" = ปิดทางลัดโหมดเดโมที่ /app (โหมด Supabase ปิดให้อัตโนมัติอยู่แล้ว)

# ---------- Push Notification (แอป native — FCM) ----------
# Firebase → Project Settings → Service accounts → Generate new private key → วางเนื้อ JSON ทั้งก้อน
FCM_SERVICE_ACCOUNT_JSON=

# Push auto-trigger (Supabase DB Webhook → /api/push/hook)
PUSH_HOOK_SECRET=

# ---------- Health detail (วินิจฉัย config) ----------
# ไม่ตั้ง = ปิด GET /api/health/detail (สาธารณะเห็นแค่ /api/health = ok/mode/rev)
# ตั้งแล้วเรียกด้วย header  x-health-secret: <ค่านี้>  เพื่อดู config/secret map
HEALTH_SECRET=

# ---------- Sentry (error monitoring) — ออปชัน ----------
# ไม่ตั้ง DSN = ปิดสนิท (พฤติกรรมเดิมทุกอย่าง) · ตั้งแล้วเริ่มเก็บ error อัตโนมัติ
# สร้าง project ที่ sentry.io แล้วเอา DSN มาใส่ (ตัวเดียวกันได้ทั้ง client/server)
NEXT_PUBLIC_SENTRY_DSN=          # DSN ฝั่ง client (เบราว์เซอร์) — เห็นได้ฝั่งหน้าเว็บ ปกติ
SENTRY_DSN=                      # DSN ฝั่ง server (ถ้าไม่ตั้ง จะ fallback ไปใช้ NEXT_PUBLIC_SENTRY_DSN)
# อัป source map (สื่อ stack trace ให้อ่านง่าย) — ตั้งครบ 3 ตัวนี้เฉพาะตอน deploy ที่อยากได้ source map
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=               # ไม่ตั้ง = ข้ามการอัป source map (build ยังผ่านปกติ)

# ---------- ลบบัญชีถาวรหลัง soft-delete (ออปชัน) ----------
# ผู้ใช้กดลบบัญชี = soft-delete (ปิดใช้งาน + เก็บไว้ช่วง grace กู้คืนได้)
# /api/account/purge = ลบถาวรหลังพ้น grace (default 30 วัน) — เปิดด้วย secret ตัวใดตัวหนึ่ง:
#
# CRON_SECRET — สำหรับ Vercel Cron (ตั้งใน vercel.json ยิงทุกวัน 03:00 UTC / 10:00 ไทย)
#   Vercel จะแนบ header  Authorization: Bearer <CRON_SECRET>  ให้อัตโนมัติ · ไม่ตั้ง = cron ไม่ผ่าน auth
CRON_SECRET=
# ACCOUNT_PURGE_SECRET — สำหรับเรียกมือ  header  x-purge-secret: <ค่านี้>  (ไม่ตั้งก็ได้ถ้าใช้ cron อย่างเดียว)
ACCOUNT_PURGE_SECRET=
